FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6389
FALKORDB_GRAPH=recallops
# Optional. Without a key the UI explicitly uses deterministic graph investigation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional independent critic model. Defaults to OPENAI_MODEL.
# OPENAI_REVIEW_MODEL=gpt-4.1-mini

# Optional Gemini audio. This key is separate from the OpenAI investigator key.
GEMINI_API_KEY=
GEMINI_TRANSCRIBE_MODEL=gemini-3.8-flash
GEMINI_SPEECH_MODEL=gemini-3.8-flash-lite-tts
